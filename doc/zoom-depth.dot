digraph statechart {
  compound=true; newrank=true; rankdir=TB;
  bgcolor="#f7f8fa"; pad=0.3; nodesep=0.4; ranksep=0.45;
  fontname="Helvetica"; fontcolor="#1c2230";
  node [fontname="Helvetica" fontsize=12 fontcolor="#1c2230" margin="0.15,0.06"];
  edge [fontname="Courier" fontsize=10 arrowsize=0.8];
  "init_s0" [shape="point" width=0.12 color="#2b313b" fillcolor="#2b313b"];
subgraph "cluster_s1" {
  id="state:player"; class="sv-container";
  label="player";
  labeljust="l"; labelloc="t"; fontsize=12;
  style="rounded";
  color="#b8860b";
  penwidth=2.5;
  "s1" [shape=point style=invis width=0.01 height=0.01 label=""];
  "init_s1" [shape="point" width=0.12 color="#2b313b" fillcolor="#2b313b"];
  "s2" [id="state:player/on" class="sv-collapsed" label="on\n⊞ 4 states" shape="box" style="rounded,filled,bold" fillcolor="#ffe08a" color="#b8860b" penwidth=2.5];
  "s8" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="off" id="state:player/off" class="sv-state" shape="box"];
}
  "s9" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" peripheries=2 label="unplugged" id="state:player/unplugged" class="sv-state" shape="box"];
  "init_s1" -> "s2" [color="#2b313b" arrowsize=0.7];
  "init_s0" -> "s1" [lhead="cluster_s1" color="#2b313b" arrowsize=0.7];
  "s1" -> "s9" [label=" unplug " ltail="cluster_s1" color="#5a6472" fontcolor="#1c2230"];
  "s2" -> "s8" [label=" power " color="#5a6472" fontcolor="#1c2230"];
  "s8" -> "s2" [label=" power " color="#5a6472" fontcolor="#1c2230"];
}
