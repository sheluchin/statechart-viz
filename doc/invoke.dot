digraph statechart {
  compound=true; newrank=true; rankdir=TB;
  bgcolor="#f7f8fa"; pad=0.3; nodesep=0.4; ranksep=0.45;
  fontname="Helvetica"; fontcolor="#1c2230";
  node [fontname="Helvetica" fontsize=12 fontcolor="#1c2230" margin="0.15,0.06"];
  edge [fontname="Courier" fontsize=10 arrowsize=0.8];
  "init_s0" [shape="point" width=0.12 color="#2b313b" fillcolor="#2b313b"];
subgraph "cluster_s1" {
  id="state:game"; class="sv-container";
  label="game";
  labeljust="l"; labelloc="t"; fontsize=12;
  style="rounded";
  color="#b8860b";
  penwidth=2.5;
  "s1" [shape=point style=invis width=0.01 height=0.01 label=""];
  "init_s1" [shape="point" width=0.12 color="#2b313b" fillcolor="#2b313b"];
  "s2" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="ready" id="state:game/ready" class="sv-state" shape="box"];
  "s3" [color="#b8860b" fillcolor="#ffe08a" penwidth=2.5 style="rounded,filled,dashed" label="Playing\n⤵ coin" id="state:game/playing" class="sv-state sv-invokes" shape="box"];
  "s4" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" peripheries=2 label="Game Over" id="state:game/over" class="sv-state" shape="box"];
}
  "init_s0" -> "s1" [lhead="cluster_s1" color="#2b313b" arrowsize=0.7];
  "init_s1" -> "s2" [color="#2b313b" arrowsize=0.7];
  "s2" -> "s3" [label=" play " color="#5a6472" fontcolor="#1c2230"];
  "s3" -> "s4" [label=" finish " color="#5a6472" fontcolor="#1c2230"];
}
