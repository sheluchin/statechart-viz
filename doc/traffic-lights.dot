digraph statechart {
  compound=true; newrank=true; rankdir=TB;
  bgcolor="#f7f8fa"; pad=0.3; nodesep=0.4; ranksep=0.45;
  fontname="Helvetica"; fontcolor="#1c2230";
  label="after :warn-pedestrians, :warn-traffic"; labelloc="t"; labeljust="l"; fontsize=14;
  node [fontname="Helvetica" fontsize=12 fontcolor="#1c2230" margin="0.15,0.06"];
  edge [fontname="Courier" fontsize=10 arrowsize=0.8];
  "init_s0" [shape="point" width=0.12 color="#2b313b" fillcolor="#2b313b"];
subgraph "cluster_s1" {
  id="state:@parallel.1"; class="sv-container";
  label="Traffic lights   ∥";
  labeljust="l"; labelloc="t"; fontsize=12;
  style="rounded,dashed";
  color="#b8860b";
  penwidth=2.5;
  "s1" [shape=point style=invis width=0.01 height=0.01 label=""];
subgraph "cluster_s2" {
  id="state:east-west"; class="sv-container";
  label="east-west";
  labeljust="l"; labelloc="t"; fontsize=12;
  style="rounded";
  color="#b8860b";
  penwidth=2.5;
  "s2" [shape=point style=invis width=0.01 height=0.01 label=""];
  "init_s2" [shape="point" width=0.12 color="#2b313b" fillcolor="#2b313b"];
  "s3" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="red" id="state:east-west/red" class="sv-state" shape="box"];
  "s4" [color="#b8860b" fillcolor="#ffe08a" penwidth=2.5 style="rounded,filled" label="yellow" id="state:east-west/yellow" class="sv-state" shape="box"];
  "s5" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="green" id="state:east-west/green" class="sv-state" shape="box"];
}
subgraph "cluster_s6" {
  id="state:north-south"; class="sv-container";
  label="north-south";
  labeljust="l"; labelloc="t"; fontsize=12;
  style="rounded";
  color="#b8860b";
  penwidth=2.5;
  "s6" [shape=point style=invis width=0.01 height=0.01 label=""];
  "init_s6" [shape="point" width=0.12 color="#2b313b" fillcolor="#2b313b"];
  "s7" [color="#b8860b" fillcolor="#ffe08a" penwidth=2.5 style="rounded,filled" label="red" id="state:north-south/red" class="sv-state" shape="box"];
  "s8" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="yellow" id="state:north-south/yellow" class="sv-state" shape="box"];
  "s9" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="green" id="state:north-south/green" class="sv-state" shape="box"];
}
subgraph "cluster_s10" {
  id="state:cross-ew"; class="sv-container";
  label="cross-ew";
  labeljust="l"; labelloc="t"; fontsize=12;
  style="rounded";
  color="#b8860b";
  penwidth=2.5;
  "s10" [shape=point style=invis width=0.01 height=0.01 label=""];
  "init_s10" [shape="point" width=0.12 color="#2b313b" fillcolor="#2b313b"];
  "s11" [color="#b8860b" fillcolor="#ffe08a" penwidth=2.5 style="rounded,filled" label="red" id="state:cross-ew/red" class="sv-state" shape="box"];
  "s12" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="flashing-white" id="state:cross-ew/flashing-white" class="sv-state" shape="box"];
  "s13" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="white" id="state:cross-ew/white" class="sv-state" shape="box"];
}
subgraph "cluster_s14" {
  id="state:cross-ns"; class="sv-container";
  label="cross-ns";
  labeljust="l"; labelloc="t"; fontsize=12;
  style="rounded";
  color="#b8860b";
  penwidth=2.5;
  "s14" [shape=point style=invis width=0.01 height=0.01 label=""];
  "init_s14" [shape="point" width=0.12 color="#2b313b" fillcolor="#2b313b"];
  "s15" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="red" id="state:cross-ns/red" class="sv-state" shape="box"];
  "s16" [color="#b8860b" fillcolor="#ffe08a" penwidth=2.5 style="rounded,filled" label="flashing-white" id="state:cross-ns/flashing-white" class="sv-state" shape="box"];
  "s17" [color="#5a7a99" fillcolor="#ffffff" penwidth=1.2 style="rounded,filled" label="white" id="state:cross-ns/white" class="sv-state" shape="box"];
}
}
  "init_s0" -> "s1" [lhead="cluster_s1" color="#2b313b" arrowsize=0.7];
  "init_s2" -> "s5" [color="#2b313b" arrowsize=0.7];
  "init_s6" -> "s7" [color="#2b313b" arrowsize=0.7];
  "init_s10" -> "s11" [color="#2b313b" arrowsize=0.7];
  "init_s14" -> "s17" [color="#2b313b" arrowsize=0.7];
  "s3" -> "s5" [label=" swap-flow " color="#5a6472" fontcolor="#1c2230"];
  "s4" -> "s3" [label=" swap-flow " color="#5a6472" fontcolor="#1c2230"];
  "s5" -> "s4" [label=" warn-traffic " color="#5a6472" fontcolor="#1c2230"];
  "s7" -> "s9" [label=" swap-flow " color="#5a6472" fontcolor="#1c2230"];
  "s8" -> "s7" [label=" swap-flow " color="#5a6472" fontcolor="#1c2230"];
  "s9" -> "s8" [label=" warn-traffic " color="#5a6472" fontcolor="#1c2230"];
  "s11" -> "s13" [label=" swap-flow " color="#5a6472" fontcolor="#1c2230"];
  "s12" -> "s11" [label=" swap-flow " color="#5a6472" fontcolor="#1c2230"];
  "s13" -> "s12" [label=" warn-pedestrians " color="#5a6472" fontcolor="#1c2230"];
  "s15" -> "s17" [label=" swap-flow " color="#5a6472" fontcolor="#1c2230"];
  "s16" -> "s15" [label=" swap-flow " color="#5a6472" fontcolor="#1c2230"];
  "s17" -> "s16" [label=" warn-pedestrians " color="#5a6472" fontcolor="#1c2230"];
}
